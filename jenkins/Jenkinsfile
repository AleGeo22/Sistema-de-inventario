pipeline {
    agent { label 'docker-agent' } // Agente por defecto para todo

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(daysToKeepStr: '10'))
    }

    triggers {
        cron('H 0 * * *') 
        pollSCM('H/15 * * * *') 
    }

    stages {
        stage('Inicio & Verificación de Herramientas') {
            agent {
                docker { 
                    image 'node:20-slim'
                    label 'docker-agent' 
                    args '-u 0'
                } 
            }
            steps {
                echo "Iniciando pipeline en contenedor temporal..."
                sh 'node -v'
                // Nota: npm install -g pytest instala el paquete npm, no la librería python
                sh 'npm install -g pytest' 
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t mi-app:latest -f jenkins/agents/Dockerfile.jenkins-agent .'
            }
        }

      stage('Run Tests') {
    agent {
        docker {
            image 'mi-app:latest'
            label 'docker-agent'
        }
    }
    steps {
        sh '''
            python3 -V
            pip3 install pytest
            pytest tests/ --junitxml=results.xml
        '''
    }
    post {
        always { junit 'results.xml' }
    }
}

        stage('SonarQube Analysis') {
            agent {
                docker { 
                    image 'sonarsource/sonar-scanner-cli'
                    label 'docker-agent' 
                }
            }
            steps {
                withCredentials([string(credentialsId: 'sqa-token-id', variable: 'SQ_TOKEN')]) {
                    sh """
                    sonar-scanner \\
                        -Dsonar.projectKey=mi-proyecto \\
                        -Dsonar.sources=. \\
                        -Dsonar.host.url=http://mi-sonarqube:9000 \\
                        -Dsonar.login=\${SQ_TOKEN}
                    """
                }
            }
        }

        stage('Terraform & Checkov Scan') {
            agent {
                docker { 
                    image 'bridgecrew/checkov:latest'
                    label 'docker-agent' 
                } 
            }
            steps {
                withCredentials([aws(credentialsId: 'aws-creds-id', variable: 'AWS_CREDENTIALS')]) {
                    sh """
                    echo "Ejecutando Checkov..."
                    # Nota: checkov no está instalado en esta imagen base (bridgecrew/checkov)
                    # La imagen de bridgecrew/checkov ya incluye checkov.
                    checkov -d ./terraform --compact

                    echo "Ejecutando Terraform..."
                    # Checkov incluye Terraform, se usa el mismo agente
                    terraform init
                    terraform plan -out=tfplan
                    """
                }
            }
        }

        stage('Terraform Apply') {
            agent {
                docker { 
                    image 'bridgecrew/checkov:latest'
                    label 'docker-agent' 
                } 
            }
            steps {
                withCredentials([aws(credentialsId: 'aws-creds-id', variable: 'AWS_CREDENTIALS')]) {
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }
    } // <--- Cierre del bloque 'stages'

    post {
        success { echo "Pipeline completado con éxito" }
        failure { echo "Pipeline falló" }
    }

} // <--- Cierre final del bloque 'pipeline'







